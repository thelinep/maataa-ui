{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.maataa.ui/v1/control-receipt.schema.json",
  "x-maataa-contract-version": "1.0.0",
  "title": "ControlReceipt",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "commandId": {
      "type": "string",
      "description": "Command ID"
    },
    "acknowledged": {
      "type": "boolean",
      "description": "Device/gateway acknowledgement"
    },
    "verified": {
      "type": "boolean",
      "description": "Observed-state verification"
    },
    "terminalState": {
      "type": "string",
      "enum": [
        "verified",
        "denied",
        "nack",
        "cancelled",
        "timed_out",
        "failed",
        "verification_failed"
      ]
    },
    "evidenceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "Evidence ID"
      }
    },
    "observedAt": {
      "type": "string",
      "description": "ISO time"
    }
  },
  "required": [
    "commandId",
    "acknowledged",
    "verified",
    "terminalState"
  ]
}
