*.key
*.p12
*.pfx

# Logs and temporary files
*.log
*.log.*
*.tmp
*.temp
*.swp
*.swo
*~

# Operating-system metadata
.DS_Store
._*
Thumbs.db
desktop.ini

# IDE/editor state
.idea/
