build/
out/
release/
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/
storybook-static/

# Tool caches
.cache/
.vite/
.turbo/
.eslintcache
.stylelintcache

# Local application data and database sidecars
.local-dev/
*.db-shm
*.db-wal
*.sqlite-shm
*.sqlite-wal

# Environment files and local-only variables
.env
.env.*
!.env.example
.dev.vars
