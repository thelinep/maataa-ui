          "status": 409,
          "code": "SPATIAL_LAYOUT_VERSION_CONFLICT",
          "currentVersionReturned": true,
          "writePerformed": false,
          "automaticMerge": false,
          "automaticRetry": false
        },
        "lifecycleRule": "Only draft spatial layouts are editable through this working-layout PATCH; status transitions are outside this contract."
