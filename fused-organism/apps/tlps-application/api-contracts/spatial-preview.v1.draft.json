  "layoutDataContract": {
    "status": "MAATAA_AUTHORED_DRAFT_FROM_CURRENT_EDITOR_MODEL; LOCAL_CONFORMANCE_RULES_FROZEN",
    "schemaId": "tlps.spatial-layout-data.v1",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": [
        "schemaVersion",
        "canvas2d",
        "scene3d"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "tlps.spatial-layout-data/v1"
        },
        "canvas2d": {
          "type": "object",
          "required": [
            "coordinateSpace",
            "width",
            "height",
            "origin",
            "units",
            "items"
          ],
          "additionalProperties": false,
          "properties": {
            "coordinateSpace": {
              "const": "maataa-canvas-world-v1"
            },
            "width": {
              "const": 1200
            },
            "height": {
              "const": 760
            },
            "origin": {
              "const": "top-left; x increases right; y increases down"
            },
            "units": {
              "const": "canvas-world-units"
            },
            "items": {
              "type": "array",
              "maxItems": 1000,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "kind",
                  "x",
                  "y",
                  "width",
                  "height",
                  "title"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "kind": {
                    "enum": [
                      "rectangle",
                      "note",
                      "ellipse"
                    ]
                  },
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1200
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 760
                  },
                  "width": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1200
                  },
                  "height": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 760
                  },
                  "title": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "color": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?$"
                  }
                }
              }
            }
          }
        },
        "scene3d": {
          "type": "object",
          "required": [
            "coordinateUnits",
            "rotationUnit",
            "models"
          ],
          "additionalProperties": false,
          "properties": {
            "coordinateUnits": {
              "type": "string",
              "minLength": 1,
              "description": "Must equal the parent spatial_project.units value."
            },
            "rotationUnit": {
              "const": "radian"
            },
            "models": {
              "type": "array",
              "maxItems": 250,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "name",
                  "geometry",
                  "position",
                  "rotation",
                  "scale",
                  "material"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 160
                  },
                  "geometry": {
                    "enum": [
                      "box",
                      "sphere",
                      "plane"
                    ]
                  },
                  "position": {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "minimum": -10000,
                      "maximum": 10000
                    },
                    "minItems": 3,
                    "maxItems": 3
                  },
                  "rotation": {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "minimum": -10000,
                      "maximum": 10000
                    },
                    "minItems": 3,
                    "maxItems": 3
                  },
                  "scale": {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "minimum": 0.05,
                      "maximum": 100
                    },
                    "minItems": 3,
                    "maxItems": 3
                  },
                  "material": {
                    "type": "object",
                    "required": [
                      "color",
                      "opacity",
                      "unlit"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "color": {
                        "type": "string",
                        "pattern": "^#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?$"
                      },
                      "opacity": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "unlit": {
                        "type": "boolean"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "$defs": {
        "vector3": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        }
      }
    },
