          "mediaType": "application/json",
          "allowedTopLevelFields": [
            "name",
            "canvasWidth",
            "canvasHeight",
            "layoutData",
            "expectedVersion"
          ],
          "layoutData": "FULL_REPLACEMENT",
          "unknownProperties": "REJECT",
          "identityAndCreatedFields": "REJECT",
          "version": "REJECT_CLIENT_VALUE; host increments same row exactly once after accepted save",
          "emptyMutablePatch": "REJECT"
        },
        "conflict": {
