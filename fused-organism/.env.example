# Copy to .env for local tooling. Keep .env untracked and never commit secret values.
# Leave unset until the matching target/account has been designated and verified.

# Required for staging infrastructure provisioning
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
SUPABASE_ACCESS_TOKEN=
SUPABASE_STAGING_PROJECT_REF=
SUPABASE_STAGING_DB_PASSWORD=
SUPABASE_STAGING_URL=
SUPABASE_STAGING_ANON_KEY=
SUPABASE_STAGING_SERVICE_ROLE_KEY=
TF_VAR_cloudflare_api_token=
TF_VAR_supabase_access_token=

# Optional: production is a later, separately approved target
SUPABASE_PRODUCTION_PROJECT_REF=
SUPABASE_PRODUCTION_DB_PASSWORD=

# Optional monitoring integration
SENTRY_DSN=

# Security notes:
# - Never commit the populated .env file or paste its values into chat.
# - Supabase service-role keys bypass RLS; keep server-only and do not use for
#   user-scoped authorization.
# - Store only secret references in the MAATAA control plane.
