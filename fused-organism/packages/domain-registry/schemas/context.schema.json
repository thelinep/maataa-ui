{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "maataa://domain-registry/context/1.0.0",
  "title": "Domain Context Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "status",
    "stability",
    "dependsOn",
    "provides",
    "contracts",
    "tables",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][A-Za-z0-9]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "status": {
      "enum": [
        "implemented",
        "stubbed",
        "planned"
      ]
    },
    "stability": {
      "enum": [
        "experimental",
        "beta",
        "stable",
        "deprecated"
      ]
    },
    "dependsOn": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "provides": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "contracts": {
      "type": "array"
    },
    "tables": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "source",
        "authored"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "authored": {
          "type": "boolean"
        }
      }
    }
  }
}
