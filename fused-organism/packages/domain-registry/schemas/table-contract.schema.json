{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maataa.local/schemas/table-contract.schema.json",
  "title": "MAATAA Canonical Table Contract",
  "description": "Database-neutral table semantics. Completeness is derived by the registry validator and cannot be asserted by a contract author.",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "context",
    "name",
    "version",
    "provenance"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*\\.[a-z][a-z0-9_]*$"
    },
    "context": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "fields": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/field"
      }
    },
    "enums": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "values"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "values": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "provenance": {
            "$ref": "#/$defs/provenance"
          }
        },
        "additionalProperties": false
      }
    },
    "primaryKey": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "uniqueConstraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/constraint"
      }
    },
    "foreignKeys": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/foreignKey"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "indexes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/index"
      }
    },
    "ownership": {
      "$ref": "#/$defs/ownership"
    },
    "lifecycle": {
      "$ref": "#/$defs/lifecycle"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "description": {
      "type": "string"
    },
    "schemaLifecycle": {
      "enum": [
        "DRAFT",
        "REVIEWED",
        "CANONICAL"
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "field": {
      "type": "object",
      "required": [
        "type",
        "nullable"
      ],
      "properties": {
        "type": {
          "enum": [
            "uuid",
            "string",
            "text",
            "int",
            "decimal",
            "float",
            "boolean",
            "date",
            "datetime",
            "time",
            "json",
            "bytes",
            "enum"
          ]
        },
        "nullable": {
          "type": "boolean"
        },
        "generated": {
          "type": "boolean"
        },
        "defaultLiteral": {},
        "defaultExpression": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "current-timestamp"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "uuid-v4"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "kind",
                "expression",
                "dialect"
              ],
              "properties": {
                "kind": {
                  "const": "database-native"
                },
                "expression": {
                  "type": "string",
                  "minLength": 1
                },
                "dialect": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "maxLength": {
          "type": "integer",
          "minimum": 1
        },
        "precision": {
          "type": "integer",
          "minimum": 1
        },
        "scale": {
          "type": "integer",
          "minimum": 0
        },
        "enumId": {
          "type": "string"
        },
        "timezone": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "additionalProperties": false
    },
    "constraint": {
      "type": "object",
      "required": [
        "name",
        "fields"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "additionalProperties": false
    },
    "foreignKey": {
      "type": "object",
      "required": [
        "name",
        "fields",
        "references",
        "referencedFields",
        "onDelete",
        "onUpdate"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "references": {
          "type": "string"
        },
        "referencedFields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "onDelete": {
          "enum": [
            "cascade",
            "restrict",
            "set-null",
            "set-default",
            "no-action"
          ]
        },
        "onUpdate": {
          "enum": [
            "cascade",
            "restrict",
            "set-null",
            "set-default",
            "no-action"
          ]
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "required": [
        "name",
        "to",
        "cardinality"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "from": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "to": {
          "type": "string"
        },
        "toFields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "cardinality": {
          "enum": [
            "one-to-one",
            "one-to-many",
            "many-to-one",
            "many-to-many"
          ]
        },
        "through": {
          "type": "object",
          "required": [
            "tableId",
            "sourceForeignKey",
            "targetForeignKey"
          ],
          "properties": {
            "tableId": {
              "type": "string"
            },
            "sourceForeignKey": {
              "type": "string"
            },
            "targetForeignKey": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "cardinality": {
                "const": "many-to-many"
              }
            },
            "required": [
              "cardinality"
            ]
          },
          "then": {
            "required": [
              "through"
            ],
            "properties": {
              "from": {
                "not": {}
              },
              "toFields": {
                "not": {}
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "cardinality": {
                "enum": [
                  "one-to-one",
                  "one-to-many",
                  "many-to-one"
                ]
              }
            },
            "required": [
              "cardinality"
            ]
          },
          "then": {
            "required": [
              "from",
              "toFields"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "index": {
      "type": "object",
      "required": [
        "name",
        "fields",
        "unique"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "unique": {
          "type": "boolean"
        },
        "method": {
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "additionalProperties": false
    },
    "ownership": {
      "type": "object",
      "required": [
        "owner",
        "steward"
      ],
      "properties": {
        "owner": {
          "type": "string"
        },
        "steward": {
          "type": "string"
        },
        "tenantKey": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "additionalProperties": false
    },
    "lifecycle": {
      "type": "object",
      "required": [
        "createdAt"
      ],
      "properties": {
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        },
        "retiredAt": {
          "type": "string"
        },
        "softDeleteField": {
          "type": "string"
        },
        "retentionPolicy": {
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "mutable": {
          "type": "string"
        },
        "retentionAnchor": {
          "type": "string"
        },
        "purge": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "evidence"
          ],
          "properties": {
            "kind": {
              "const": "MAATAA_AUTHORED"
            },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "reviewedBy": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "source",
            "sourceRevision"
          ],
          "properties": {
            "kind": {
              "const": "ADOPTED_SOURCE"
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "sourceRevision": {
              "type": "string",
              "minLength": 1
            },
            "reviewedBy": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "source",
            "reference",
            "reviewStatus"
          ],
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1
            },
            "reference": {
              "type": "string",
              "minLength": 1
            },
            "reviewStatus": {
              "enum": [
                "unreviewed",
                "reviewed",
                "approved"
              ]
            },
            "reviewedBy": {
              "type": "string"
            },
            "reviewedAt": {
              "type": "string",
              "format": "date-time"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
