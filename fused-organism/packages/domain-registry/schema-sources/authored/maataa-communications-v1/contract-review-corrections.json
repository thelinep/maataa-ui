  "baselineContractSetHash": "abda114aaeb94d5f4494f77bdb2e9de69097c595765b304d720912fb041099da",
  "decisionStatus": "ACCEPTED_FOR_SCHEMA_CORRECTION",
  "reviewer": "thelinep",
  "reviewedAt": "2026-10-02T20:57:13.345Z",
  "decisions": [
    {
      "finding": "tenant-integrity",
      "decision": "All workspace-membership references carry membership id, workspace id, and organisation id; the referenced Organisation key is added by a separately recorded additive amendment."
    },
    {
      "finding": "direct-message-pair",
      "decision": "A database-level logical invariant requires strict UUID binary ordering; equality is therefore forbidden. The unique workspace pair remains."
    },
    {
      "finding": "announcement-scope",
      "decision": "Only ORGANISATION and WORKSPACE audiences are supported; audience kind and workspace nullability must agree."
    },
    {
      "finding": "membership-history",
      "decision": "Each row is an episode identified by its generated UUID. Rejoining creates another row, even at the same timestamp; only one active episode per tenant/workspace/thread/membership is allowed."
    }
  ],
  "unresolved": [
    "Prisma validation alone does not prove provider-specific trigger, CHECK, and partial-index enforcement; see the hash-bound provider enforcement plan and migration previews.",
    "Legal retention approval, migration approval, deployment approval, and canonical promotion are not granted by this correction record."
  ],
