{
  "name": "@maataa/domain-registry",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "exports": {
    ".": "./src/index.mjs",
    "./composition": "./src/composition.mjs",
    "./contracts": "./src/contracts.mjs",
    "./sql-proposal": "./src/sql-proposal.mjs"
  },
  "files": [
    "catalog",
    "contexts",
    "flows",
    "products",
    "routes",
    "schemas",
    "data",
