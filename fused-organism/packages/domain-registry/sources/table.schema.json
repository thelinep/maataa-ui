{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "maataa://domain-registry/table/1.0.0",
  "type": "object",
  "required": [
    "id",
    "name",
    "domain",
    "context",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*\\.[a-z][a-z0-9_]*$"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "domain": {
      "type": "string",
      "enum": [
        "identity-access",
        "organisation-workspace",
        "projects",
        "development-creative",
        "casting-talent",
        "crew-departments",
        "scheduling-live-production",
        "locations-logistics-equipment",
        "campaign-os",
        "marketplace-procurement",
        "evidence-documents-governance",
        "finance-commerce",
        "investor-rights-revenue",
        "events-weddings-spatial",
        "ai-research-analytics",
        "communications-notifications",
        "admin-integrations-operations",
        "public-cms-growth"
      ]
    },
    "context": {
      "type": "string",
      "enum": [
        "identity",
        "organisation",
        "project",
        "creative",
        "people",
        "production",
        "logistics",
        "campaign",
        "marketplace",
        "evidence",
        "finance",
        "investor",
        "eventsSpatial",
        "intelligence",
        "communications",
        "platform",
        "public"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "implemented",
        "stubbed",
        "planned"
      ]
    },
    "futureProduction": {
      "type": "boolean",
      "default": false
    }
  }
}
