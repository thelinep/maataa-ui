{
  "name": "maataa-ui",
  "version": "1.0.0",
  "description": "Advanced relationship intelligence platform with real-time collaboration",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "fused:test": "npm --prefix fused-organism test --workspace @maataa/domain-registry",
    "fused:validate": "npm --prefix fused-organism run validate --workspace @maataa/domain-registry",
    "test:e2e": "vitest --run tests/e2e",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "uuid": "^9.0.0",
    "events": "^3.3.0",
    "styled-components": "^6.1.0",
    "react-router": "^8.5.2",
    "i18next": "^27.2.2",
    "react-i18next": "^18.0.3"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.1.0",
    "vite": "^4.4.0",
    "vitest": "^0.34.0",
    "@vitest/ui": "^0.34.0",
    "@vitest/coverage-v8": "^0.34.0",
    "eslint": "^8.45.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/jest-dom": "^6.1.0",
    "jsdom": "^22.1.0",
    "@types/uuid": "^9.0.0",
    "@testing-library/dom": "^10.4.2"
  },
  "keywords": [
    "collaboration",
    "real-time",
    "relationship-intelligence",
    "analytics",
    "react"
  ],
  "author": "Maataa Team",
  "license": "MIT",
  "engines": {
    "node": ">=22.22.0"
  }
}
