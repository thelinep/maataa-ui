{
  "name": "maataa-ui",
  "version": "1.0.0",
  "description": "Advanced relationship intelligence platform with real-time collaboration",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "setup": "npm run fused:install && npm run fused:build && npm install",
    "fused:install": "npm --prefix fused-organism ci --ignore-scripts --no-audit --no-fund",
    "fused:build": "npm --prefix fused-organism run build:ui",
    "fused:sync": "npm run fused:build && npm install",
    "postinstall": "node scripts/check-fused-packages.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "fused:test": "npm --prefix fused-organism test --workspace @maataa/domain-registry",
    "fused:validate": "npm --prefix fused-organism run validate --workspace @maataa/domain-registry",
    "test:e2e": "vitest --run tests/e2e",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.7",
    "@maataa/adapter-sdk": "file:fused-organism/packages/adapter-sdk",
    "@maataa/ai": "file:fused-organism/packages/ai",
    "@maataa/contracts": "file:fused-organism/packages/contracts",
    "@maataa/control": "file:fused-organism/packages/control",
    "@maataa/core": "file:fused-organism/packages/core",
    "@maataa/governance": "file:fused-organism/packages/governance",
    "@maataa/primitives": "file:fused-organism/packages/primitives",
    "@maataa/react": "file:fused-organism/packages/react",
    "@maataa/registry": "file:fused-organism/packages/registry",
    "@maataa/renderer": "file:fused-organism/packages/renderer",
    "@maataa/tokens": "file:fused-organism/packages/tokens",
    "@maataa/ui": "file:fused-organism/packages/maataa-ui",
    "events": "^3.3.0",
    "i18next": "^27.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-i18next": "^18.0.3",
    "react-router": "^8.5.2",
    "styled-components": "^6.1.0",
    "uuid": "^9.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/node": "^22.12.0",
    "typescript": "^5.1.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "@vitest/ui": "^5.1.1",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^8.45.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/jest-dom": "^6.1.0",
    "jsdom": "^31.0.1",
    "@types/uuid": "^9.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/user-event": "^14.6.13",
    "@vitejs/plugin-react": "^6.3.0"
  },
  "keywords": [
    "collaboration",
    "real-time",
    "relationship-intelligence",
    "analytics",
    "react"
  ],
  "author": "Maataa Team",
  "license": "MIT",
  "engines": {
    "node": ">=22.22.2"
  }
}
