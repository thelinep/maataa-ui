# Project npm settings. COMMITTED TO GIT: never put auth tokens or registry
# credentials here. Put those in your user-level ~/.npmrc instead.
#
# Install file: dependencies (fused-organism packages) as copies, not symlinks,
# so they resolve React and other peers from this app's node_modules only.
# (Symlinked copies would load fused-organism's own React = two Reacts.)
install-links=true
